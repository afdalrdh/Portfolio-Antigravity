{
    "buildCommand": "npm run build:web",
    "outputDirectory": "apps/web/dist",
    "installCommand": "npm install",
    "functions": {
        "api/index.js": {
            "includeFiles": "apps/api/src/**"
        }
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/index.js"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}